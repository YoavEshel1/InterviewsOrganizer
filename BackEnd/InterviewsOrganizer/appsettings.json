{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=InterviewsOrganizer;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }, /* TODO: The Jwt__Key should not be stored in launchSettings.json as it is a sensitive information. Consider the following steps to secure it:

        •	[ ] Remove Jwt__Key from launchSettings.json
        •	[ ] Add launchSettings.json to .gitignore
        •	[ ] Move the key to Azure Key Vault or Environment Variables on the hosting platform
        •	[ ] Regenerate a new key (assume the current one is compromised since it was on GitHub)

       **** * Note: If you choose to host at a server which is not Azure,
        use the server Environment Variables, . */

  "Jwt": {
    "Key": "37b1d3ed-dfca-4bff-8d43-240bede8ec75",
    "Issuer": "InterviewsOrganizer",
    "Audience": "InterviewsOrganizerClient"
  },
  "EmailEncryption": {
    "HmacSecretKey": "37b1d3ed-dfca-4bff-8d43-240bede8ec75-email-hmac",
    "KeyRingPath": "../keys"
  },
  "AllowedHosts": "*"
}
